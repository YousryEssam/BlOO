@model string

<div class="post-input-container">
    <img src="@Model" alt="Profile Picture" class="profile-img">
    <input type="text" class="post-input" placeholder="What is in your mind ?">
    <label for="file-upload" class="upload-icon">
        <img src="~/assets/icons/upload-img.png" alt="Upload">
    </label>
    <input id="file-upload" type="file" class="d-none">
</div>

<style>
    .post-input-container {
        margin-top : 1.5rem;
        display: flex;
        align-items: center;
        background: white;
        padding: 15px;
        border-radius: 10px;
        box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.1);
        width: 100%;
    }

    .profile-img {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        margin-right: 10px;
    }

    .post-input {
        flex-grow: 1;
        border: none;
        outline: none;
        padding: 10px;
        border-radius: 20px;
        background: #f1f1f1;
        font-size: 14px;
    }

    .upload-icon img {
        margin : 10px;
        width: 24px;
        height: 24px;
        cursor: pointer;
    }
</style>

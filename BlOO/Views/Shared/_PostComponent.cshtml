@model PostViewModel

<div class="post_container">
    <div class="post_card">
        <div class="post_section">
            <div class="post_card_section_head">
                <div>
                    <img src="@Model.UserImgUrl" alt="ProfileImage" class="user_profile-photo">
                    <h3>@Model.UserName</h3>
                </div>

                <a asp-controller="Post" asp-action="EditPost" asp-route-id="@Model.Id">
                    <i class="fa-solid fa-pen-to-square"></i>
                </a>

            </div>
            <p>@Model.Content</p>
            @{
                if (!string.IsNullOrEmpty(Model.ImgUrl)) 
                {
                    <img src="/assets/post-pictures/@Model.ImgUrl" class="post-image" />
                }
            }
        </div>
    </div>

    <!-- Stats Section -->
    <div class="post-stats">
        <div class="stat">
            <i class="fa-regular fa-heart"></i>
            <strong>@Model.LikeCount</strong>
        </div>
        <div class="stat">
            <i class="fa-regular fa-comment-dots"></i>
            <strong>@Model.CommentCount</strong>
        </div>
        <input type="text" placeholder="Add Comment" class="comment-input" />
    </div>
</div>

@model ChatsViewModel
@{
    ViewData["Title"] = "Chats";
}

<link rel="stylesheet" href="~/css/chats-page.css" asp-append-version="true" />


<div class="container-fluid">

    <div class="row chat-layout">

        @* Chats List Container *@
        <div class="col-4">
            <div class="chats-list-header d-flex align-items-center justify-content-center">
                <h3 class="text-white">Chats</h3>
                <div class="group" title="Search" style="margin-right : 5px;">
                    <svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><g><path d="M21.53 20.47l-3.66-3.66C19.195 15.24 20 13.214 20 11c0-4.97-4.03-9-9-9s-9 4.03-9 9 4.03 9 9 9c2.215 0 4.24-.804 5.808-2.13l3.66 3.66c.147.146.34.22.53.22s.385-.073.53-.22c.295-.293.295-.767.002-1.06zM3.5 11c0-4.135 3.365-7.5 7.5-7.5s7.5 3.365 7.5 7.5-3.365 7.5-7.5 7.5-7.5-3.365-7.5-7.5z"></path></g></svg>
                    <input placeholder="Search" type="search" class="input">
                </div>
            </div>


            <div class="chats-list">

                @foreach (var item in Model.Conversations)
                {
                    <a asp-controller="Chats" asp-action="Chat" asp-route-id="@item.Id" class="chat-item">
                        <div class="d-flex justify-content-between conversation-item">
                            <div class="d-flex ">
                                <img src="@item.UserImgURL" class="rounded-circle" />
                                <div class="details-user">
                                    <h5>@item.FirstName @item.LastName</h5>
                                    <p class="justify-content-center">@item.LastMessage</p>
                                </div>
                            </div>

                            <div class="date-place">
                                <h6>@item.SendingDate</h6>
                            </div>
                        </div>
                    </a>
                }

                @* **************** This Will remove after get data from database **********************************@
                @*     @for (var i = 1; i <= 6; i++)
                {

                <div class="d-flex justify-content-around conversation-item">
                <img src="@Model.ProfileImageUrl" class="rounded-circle" />
                <div class="details-user">
                <h5>@Model.FirstName @Model.LastName</h5>
                <p>@Model.Content</p>
                </div>
                <div class="date-place">
                <h6>@Model.SendingDate</h6>
                </div>
                </div>
                } *@
            </div>


            <div class="chat-list-control d-flex justify-content-center align-items-center overflow-hidden">

                <div class="d-flex justify-content-between align-items-center control-bar">
                    
                        <div class="d-flex control-btn justify-content-start align-items-center ">
                            <button class="previous">
                                <a style="border: navajowhite;background-color: transparent;" asp-action="Index" asp-route-pageNumber="@(ViewBag.PageNumber - 1)" asp-route-pageSize="@ViewBag.PageSize" class="btn btn-primary">
                                    <img src="~/assets/icons/previous.png" /> 
                                </a>
                            </button>
                            <h6>Previous</h6>
                        </div>
                    
                   
                        <div class="d-flex control-btn justify-content-start align-items-center">
                            <h6>Next</h6>
                            <button class="next">
                            <a  style="border: navajowhite;background-color: transparent;"asp-action="Index" asp-route-pageNumber="@(ViewBag.PageNumber + 1)" asp-route-pageSize="@ViewBag.PageSize" class="btn btn-primary">
                                 <img src="~/assets/icons/next.png" />
                            </a>
                        </button>
                        </div>
                </div>

            </div>

        </div>

        @* Open Chat Container *@
        <div class="col-8 active-chat">
            @if (Model.TargetUserId == 0)
            {
                @* if no chat is active *@
                <div class="container d-flex justify-content-center align-items-center vh-100 text-black">
                    <div class="text-center">
                        <h3 class="mt-3 fw-semibold">BlOO Chats</h3>
                        <p class="text-muted">Send and receive messages with your friends.</p>
                        <p class="text-muted small"><i class="bi bi-lock"></i> End-to-end encrypted</p>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center chats-list-header">
                    <div class="user_info">
                        <img src="@Model.ActiveChat.ProfileImageUrl" />
                        <h4>@Model.ActiveChat.FirstName @Model.ActiveChat.LastName</h4>
                    </div>
                    <div>
                        <a asp-controller="User" asp-action="Profile" asp-route-id="@Model.ActiveChat.Id" class="btn btn_profile">View Profile</a>
                    </div>
                </div>

                <div id="messageArea"></div>

                <div class="message-input-container">
                    <input type="text" name="message" placeholder="Type a Message!" id="MessageBox" class="form-control message-input" />
                    <button name="send" onclick="SendMessage()" class="send-button"><i class="fa-regular fa-paper-plane"></i> </button>
                </div>

            }
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/microsoft-signalr/signalr.min.js"></script>
<script>
    // Create Connection
    var connection = new signalR.HubConnectionBuilder().withUrl("/ChatMessage").build();
    
    // Test Connection
    connection.start().then(function () {
        console.log("Connected");
    })
    .catch(function (err) {
        return console.error(err.toString());
    });

    // connection.on("TestNewMsg", function (MSG){
    //     console.log(MSG);
    // });

    function SendMessage(Model){
        var NewMessage = $("#MessageBox").val();
        $("#MessageBox").val("");

        if(NewMessage == "") {
            return;
        }


        var newMessageObj = {
            SenderId: @Model.Id,   
            ReceiverId: @Model.TargetUserId, 
            Message: NewMessage
        };

        connection.invoke("NewMessage" , newMessageObj).
        catch(function (err) {
                return console.error(err.toString());
        });
    }



    


<form id="postForm" enctype="multipart/form-data" class="post-input-container">
    <img src="@User.FindFirst("imgUrl")?.Value" alt="Profile Picture" class="profile-img">

    <input name="Content" type="text" class="post-input" placeholder="What is in your mind ?" onclick="openPost()" required>

    <label for="file-upload" class="upload-icon">
        <img src="~/assets/icons/upload-img.png" alt="Upload">
    </label>
    <input name="Image" id="file-upload" type="file" class="d-none" accept="image/*">

    <button type="submit" class="add-post-btn" id="addPostBtn">Add Post</button>
</form>

<div class="overlay" id="overlay" onclick="closePost()"></div>


<style>
    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(10px);
        display: none;
        z-index: 9;
    }

    .post-input-container {
        position: relative;
        margin: 20px auto;
        margin-top: 1.5rem;
        display: flex;
        align-items: center;
        background: white;
        padding: 15px;
        border-radius: 10px;
        box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.1);
        width: 80%;
        z-index: 10;
        transition: all 0.3s ease;
    }

    .profile-img {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        margin-right: 10px;
    }

    .post-input {
        flex-grow: 1;
        border: none;
        outline: none;
        padding: 10px;
        border-radius: 20px;
        background: #f1f1f1;
        font-size: 14px;
    }

    .upload-icon img {
        margin: 10px;
        width: 24px;
        height: 24px;
        cursor: pointer;
    }

    .add-post-btn {
        display: none;
        margin-left: 10px;
        padding: 8px 15px;
        background: #007bff;
        color: white;
        border: none;
        border-radius: 20px;
        cursor: pointer;
        font-size: 14px;
        transition: background 0.3s;
    }

        .add-post-btn:hover {
            background: #0056b3;
        }

    .expanded {
        width: 90%;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
    }

        .expanded .add-post-btn {
            display: inline-block;
        }
</style>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    function openPost() {
        document.getElementById("overlay").style.display = "block";
        document.getElementById("postForm").classList.add("expanded");  
    }

    function closePost() {
        document.getElementById("overlay").style.display = "none";
        document.getElementById("postForm").classList.remove("expanded"); 
    }

    $("#postForm").submit(function (e) {
        e.preventDefault();  

        var formData = new FormData(this);  

        $.ajax({
            url: '@Url.Action("DataFromAddPost", "Post")',  
            type: 'POST',  
            data: formData,
            contentType: false,
            processData: false,  
            success: function (result) {
                console.log(result);
                $('#postContainer').prepend(result);  
                $('#postForm')[0].reset();  
        
                closePost();
            },
            error: function (error) {
                console.log("Error: " + error);
            }
        });
    });
</script>

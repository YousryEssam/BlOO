@model List<PostViewModel>
@{
    ViewData["Title"] = "Post";
}

<link rel="stylesheet" href="~/css/post-page.css" asp-append-version="true" />
<header><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    </header>

<partial name="_AddPosts" />

<div id="postContainer">
    @foreach (var post in Model)
    {
        <partial name="_ShowPosts" model="post" />
    }
</div>
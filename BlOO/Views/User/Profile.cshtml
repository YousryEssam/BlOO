@model ProfileViewModel 
@inject UserManager<ApplicationUser> UserManager 
@inject SignInManager<ApplicationUser> SignInManager
@{
    ViewData["Title"] = "Profile";
    string FullName = Model.FirstName + " " + Model.LastName;
    var loggedInUser = await UserManager.GetUserAsync(User); // Get current logged-in user
    bool isProfileOwner = loggedInUser != null && loggedInUser.Id == Model.UserId;
    bool isFollower = false;
}

<link rel="stylesheet" href="~/css/post-page.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/profile-page.css" asp-append-version="true" />

@* ********************************** Profile info Section begin *************************************** *@
<div class="profile-card">    
    <div class="cover-photo" style="background : url('@Model.CoverImageUrl');">
        <img src="@Model.ProfileImageUrl" alt="Profile" class="profile-photo">
    </div>

    <!-- Profile Info -->
    <div class="profile-info">

        <h4 class="profile-name">@FullName</h4>  
        <p class="username">&#64;@Model.UserName</p>
        <p>
            <strong>Bio :</strong> <br/>
            @if(Model.Bio != null)
            {
                @Model.Bio
            }
        </p>

        <!-- Follow & Message Buttons -->
        <div class="profile-actions d-flex justify-content-end gap-3">
            @if (SignInManager.IsSignedIn(User))
            {
                if (isProfileOwner)
                {
                    <a asp-controller="User" asp-action="EditProfile" class="btn btn-outline-secondary"><i class="fa-solid fa-pen"></i> Edit profile</a>
                }
                else
                {
                    if (isFollower)
                    {
                        <button class="btn btn-danger"><i class="fas fa-user-minus"></i> Unfollow</button>
                    }
                    else
                    {
                        <button class="btn btn-primary"><i class="fas fa-user-plus"></i> Follow</button>
                    }
                    <a asp-controller="Chats" asp-action="Chat" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">
                        <i class="fas fa-envelope"></i> Message
                    </a>
                }
            }
        </div>

    </div>

    <!-- Stats Section -->
    <div class="profile-stats">
        <div class="stat-profile-page">
            <i class="fas fa-users"></i>
            <p>Followers</p>
            <strong> @Model.FollowersCount </strong>
        </div>
        <div class="stat-profile-page">
            <i class="fas fa-user-friends"></i>
            <p>Following</p>
            <strong>@Model.FollowingCount</strong>
        </div>
        <div class="stat-profile-page">
            <i class="fas fa-file-alt"></i>
            <p>Posts</p>
            <strong>@Model.PostCount</strong>
        </div>
    </div>

</div>
@* ********************************** Profile info Section end *************************************** *@


@* **********************************Add post by partial view *************************************** *@

<partial name="_AddPosts" />

@* ***************************************** Posts by User ****************************************** *@

<div class="container">
    <h1 class="text-center">Posts</h1>
        <div id="postContainer">
            @{
                if (Model.Posts != null)
                {
                    foreach (var post in Model.Posts)
                    {
                        <partial name="_PostComponent" model="post" />
                    }
                }
            }
        </div>
</div>

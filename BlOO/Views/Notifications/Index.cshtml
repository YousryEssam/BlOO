@model List<NotificationsViewModel>
@using System.Text.Json
@{
    ViewData["Title"] = "Notifications";

}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/notifications-style.css" asp-append-version="true" />

<div class="container notification-container my-4">
    <div class="header d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Notifications</h1>
        <span class="badge rounded-pill" id="notification-count">0</span>
    </div>

    <div class="row mb-4">
        <div class="col-md-12 mb-2 mb-md-0 d-flex justify-content-center">
            <div class="btn-group filter-buttons" role="group">
                <button type="button" class="btn btn-filter active" data-filter="all">All</button>
                <button type="button" class="btn btn-filter" data-filter="unread">Unread</button>
                <button type="button" class="btn btn-filter" data-filter="read">Read</button>
            </div>
        </div>
    </div>

    <div id="notifications-list">
        <!-- Notifications will be added here -->
        <div class="empty-state">
            <p>You don't have any notifications yet.</p>
        </div>
    </div>
</div>


<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="toast" class="toast align-items-center text-white" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                Notification marked as read
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>



<!-- Bootstrap JS Bundle with Popper -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/microsoft-signalr/signalr.min.js"></script>

<script>
    
    // ========== Sample Data ==========
    /*
        ActorId : 2 , CreationDate : "2025-04-05T02:07:07"
        Id : 2 , NotificationMessage : "Yousry Ayoub Has follow you" , NotificationTypeContent : 4
        ReadStatus : false , ReferenceId : 1 , UserId : 1
    */
    let notifications = @Html.Raw(JsonSerializer.Serialize(Model));

    // ========== DOM Elements ==========
    const notificationsList = document.getElementById('notifications-list');
    const notificationCount = document.getElementById('notification-count');
    const filterButtons = document.querySelectorAll('.filter-buttons button');
    const addDemoButton = document.getElementById('add-demo');
    const toastEl = document.getElementById('toast');
    const toast = new bootstrap.Toast(toastEl);

    // ========== State ==========
    let currentFilter = 'all';


    // ========== Initialization ==========
    document.addEventListener('DOMContentLoaded', () => {
        init();
    });

    function init() {
        renderNotifications();

        // Filter buttons event listeners
        filterButtons.forEach(button => {
            button.addEventListener('click', () => {
                filterButtons.forEach(btn => btn.classList.remove('active'));
                button.classList.add('active');
                currentFilter = button.dataset.filter;
                renderNotifications();
            });
        });
    }

    // ========== Render Notifications ==========
    function renderNotifications() {
        // Apply filter
        let filteredNotifications = notifications;
        if (currentFilter === 'unread') 
        {
            filteredNotifications = notifications.filter(n => !n.ReadStatus);
        } 
        else if (currentFilter === 'read') 
        {
            filteredNotifications = notifications.filter(n => n.ReadStatus);
        }


        // Update unread count
        const unreadCount = notifications.filter(n => !n.ReadStatus).length;
        notificationCount.textContent = unreadCount;

        // Clear the list
        notificationsList.innerHTML = '';

        // Empty state
        if (filteredNotifications.length === 0) {
            const emptyState = document.createElement('div');
            emptyState.className = 'empty-state';
            emptyState.innerHTML = `<p>No ${currentFilter === 'all' ? '' : currentFilter + ' '}notifications to display.</p>`;
            notificationsList.appendChild(emptyState);
            return;
        }

        // Render each notification
        filteredNotifications.forEach(notification => {
            //console.log(notification);
            const element = createNotificationElement(notification);
            notificationsList.appendChild(element);
        });
    }

    // ========== Notification Element ==========
    const titles = [
        'Someone liked your post',       // Like
        'Someone reposted your content', // Repost
        'New comment on your post',      // Comment
        'You have a new message',        // Message
        'You have a new follower',       // Follow
        'New post published',            // Post
        'Your content was reported'      // Report
    ];
    function createNotificationElement(notification) {

        const element = document.createElement('div');
        element.className = `notification ${notification.ReadStatus ? 'read' : 'unread'}`;
        element.dataset.id = notification.Id;
        // ===========================> notification.NotificationTypeContent uncompleted
        element.innerHTML = `
            <div class="d-flex align-items-start">
                <div class="notification-icon me-3">
                    ${getIconForType(notification.NotificationTypeContent)}
                </div>
                <div class="flex-grow-1">
                    <div class="notification-title">${titles[notification.NotificationTypeContent]}</div>
                    <div class="notification-message">${notification.NotificationMessage}</div>
                    <div class="notification-time">${formatTime(notification.CreationDate)}</div>
                    <div class="d-flex justify-content-end mt-2">
                        <button class="btn btn-sm btn-action mark-read me-2">
                            ${notification.ReadStatus ? 'Mark as unread' : 'Mark as read'}
                        </button>
                        <button class="btn btn-sm btn-action delete">Delete</button>
                    </div>
                </div>
                ${!notification.ReadStatus ? '<div class="notification-dot ms-2 align-self-center"></div>' : ''}
            </div>
        `;

        // Mark as read / unread
        element.querySelector('.mark-read').addEventListener('click', () => {
            toggleReadStatus(notification.Id);
        });

        // Delete
        element.querySelector('.delete').addEventListener('click', () => {
            deleteNotification(notification.Id);
        });

        return element;
    }

    // ========== Actions ==========
    function toggleReadStatus(id) {
        const notification = notifications.find(n => n.Id === id);
        if (notification) {
            if(notification.ReadStatus){
                renderNotifications();
                return ;
            }
            ReadNotification(id ,notification.UserId);
            notification.ReadStatus = !notification.ReadStatus;
            renderNotifications();
            showToast(notification.ReadStatus ? 'Notification marked as read' : 'Notification marked as unread');
        }
    }

    function deleteNotification(id) {
        const notification = notifications.find(n => n.Id === id);
        notifications = notifications.filter(n => n.Id !== id);
        DeleteNotificationFromDB(id , notification.UserId);
        renderNotifications();
        showToast('Notification deleted');
    }

    function getIconForType(type) {
        switch (type) {
            case 0: return '<i class="bi bi-heart-fill"></i>'; // Like
            case 1: return '<i class="bi bi-share-fill"></i>'; // Repost
            case 2: return '<i class="bi bi-chat-fill"></i>'; // Comment
            case 3: return '<i class="bi bi-envelope-plus-fill"></i>'; // Message
            case 4: return '<i class="bi bi-person-plus-fill"></i>'; // Follow
            case 5: return '<i class="bi bi-postcard-heart-fill"></i>'; // Post
            case 6: return '<i class="bi bi-send-exclamation-fill"></i>'; // Report
            default: return '<i class="bi bi-bell-fill"></i>'; // default
        }
    }

    function formatTime(date) {
        const now = new Date();
        const diff = Math.floor((now - new Date(date)) / 1000);

        if (diff < 60) return 'Just now';
        if (diff < 3600) return `${Math.floor(diff / 60)} minute${diff >= 120 ? 's' : ''} ago`;
        if (diff < 86400) return `${Math.floor(diff / 3600)} hour${diff >= 7200 ? 's' : ''} ago`;

        return `${Math.floor(diff / 86400)} day${diff >= 172800 ? 's' : ''} ago`;
    }

    function showToast(message) {
        const toastBody = document.querySelector('.toast-body');
        toastBody.textContent = message;
        toast.show();
    }


    // ========== Notifications System SignalR ==========
    var connection = new signalR.HubConnectionBuilder().withUrl("/NotificationsSystem").build();
   
    // ============== Test Connection ==============
    connection.start().then(function () {
        console.log("Connected");
    }).catch(function (err) {
        return console.error(err.toString());
    });

    // ============== Connection Fucntions ==============
    function DeleteNotificationFromDB(notificationId, userId) {
        connection.invoke("DeleteNotification", notificationId, userId)
            .catch(err => console.error(err.toString()));
    }


    function ReadNotification(notificationId , userId){
        connection.invoke("ReadNotification", notificationId , userId).catch(function (err) {
                return console.error(err.toString());
        });
    }

    connection.on("ReceiveNewNotifications", function (notification) {
        if (notification.userId == @ViewBag.UserId) 
        {
            var newNotification = {
                ActorId: notification.actorId,
                CreationDate: notification.creationDate,
                Id: notification.id,
                NotificationMessage:notification.notificationMessage,
                NotificationTypeContent: notification.notificationTypeContent,
                ReadStatus: notification.readStatus,
                ReferenceId: notification.referenceId,
                UserId: notification.userId
            };
            notifications.unshift(newNotification);
            renderNotifications();
        }
    });

    connection.on("NoMoreUnseenNotifications", () => {
        const dot = document.getElementById('notification-dot');
        dot?.classList.add('d-none');
    });

    //===================================================================================
    // Every 1 minutes update page
    setInterval(()=>{
        location.reload();
    } ,60000);

</script>
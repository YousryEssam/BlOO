@model RegisterViewModel
@{

    ViewData["Title"] = "Register";
}
<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="~/css/Register-SignIn.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
</head>

<body>
    <div class="d-none d-md-block ball login bg-primary bg-gradient position-absolute rounded-circle"></div>
    <div class="position-absolute top-0 start-0 p-3">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none fw-bold fs-5">Bloo</a>
    </div>

    <div class="container register__form active">
        <div class="row w-100 align-items-center">
            <div class="col-12 col-lg-6 px-5">
                <div class="p-5 w-100">
                    <h3 class="fw-bolder">REGISTER HERE !</h3>
                    <p class="fw-lighter fs-6">Have an account, <a asp-controller="Account" asp-action="LogIn">Log In</a></p>

                    <form asp-controller="Account" asp-action="RegisterData" method="post" class="mt-5">
                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label">UserName</label>
                            <input asp-for="UserName" class="form-control text-indent shadow-sm bg-grey-light border-0 rounded-pill fw-lighter fs-7 p-3" placeholder="name">
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control text-indent shadow-sm bg-grey-light border-0 rounded-pill fw-lighter fs-7 p-3" placeholder="name@example.com">
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <div class="d-flex position-relative">
                                <input asp-for="Password" type="password" class="form-control text-indent shadow-sm bg-grey-light border-0 rounded-pill fw-lighter fs-7 p-3">
                                <span class="password__icon text-primary fs-4 fw-bold" id="toggle-password-1"></span>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                            <div class="d-flex position-relative">
                                <input asp-for="ConfirmPassword" type="password" class="form-control text-indent shadow-sm bg-grey-light border-0 rounded-pill fw-lighter fs-7 p-3">
                                <span class="password__icon text-primary fs-4 fw-bold" id="toggle-password-2"></span>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="text-center">
                            <input type="submit" class="btn btn-outline-dark btn-lg rounded-pill mt-4 w-100" value="Sign Up" />
                        </div>
                    </form>

                    <p class="mt-5 text-center">Or Sign in with social platforms</p>
                    <div class="row text-center">
                        <div class="col mt-3">
                            <a href="#" class="btn btn-outline-dark border-2 rounded-circle"><i class="bi bi-facebook fs-5"></i></a>
                        </div>
                        <div class="col mt-3">
                            <a href="#" class="btn btn-outline-dark border-2 rounded-circle"><i class="bi bi-linkedin fs-5"></i></a>
                        </div>
                        <div class="col mt-3">
                            <a href="#" class="btn btn-outline-dark border-2 rounded-circle"><i class="bi bi-twitter fs-5"></i></a>
                        </div>
                        <div class="col my-3">
                            <a href="#" class="btn btn-outline-dark border-2 rounded-circle"><i class="bi bi-google fs-5"></i></a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-none d-lg-block col-lg-6 p-5">
                <div class="text-center" style="margin-left:82px;margin-bottom:20px">
                    <img src="~/assets/icons/Emptylogo.png" class="bounce" asp-append-version="true" alt="">
                </div>
            </div>
        </div>
    </div>

    @* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.1/dist/js/bootstrap.bundle.min.js"></script> *@
</body>
</html>

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@{
    var user = await UserManager.GetUserAsync(User);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BlOO</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BlOO.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Navbar.css" asp-append-version="true" />
</head>
<body>

    <header>
        <nav class="nav navbar-expand-lg bg-white sticky-top border-bottom">
            <div class="container-fluid">
                <div class="row text-center">

                    <div class="col-4 d-flex align-items-center">
                        <a class="navbar-brand d-flex align-items-center" href="#">
                            <img src="~/assets/logo/Logo2.png" class="rounded-circle logo-img" />
                        </a>
                        <img src="~/assets/icons/search-icon.svg" alt="search-icon" style="margin:15px;" />
                        <input class="form-control custom-input" type="Search" placeholder="Search" name="search" id="search" />
                    </div>

                    <div class="col-6">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    <img src="~/assets/icons/home-button-icon.svg" class="nav-hover" />
                                    <br />
                                    <span>Home</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    <img src="~/assets/icons/compass-icon.svg" class="nav-hover" />
                                    <br />
                                    <span>Explore</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    <img src="~/assets/icons/notification-icon.svg" class="nav-hover" />
                                    <br />
                                    <span>Notification</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    <img src="~/assets/icons/setting-icon.svg" class="nav-hover" />
                                    <br />
                                    <span>Setting</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    <img src="~/assets/icons/message-bubble-icon.svg" class="nav-hover" />
                                    <br />
                                    <span>Messages</span>
                                </a>
                            </li>
                        </ul>
                    </div>


                    <div class="col-2">
                        <ul class="navbar-nav">
                            @if(SignInManager.IsSignedIn(User))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="User" asp-action="Profile" asp-route-Email="@user.Email">
                                        <img src="@user.ProfileImageUrl" class="rounded-circle nav-hover" />
                                        <br />
                                        <span>Profile</span>
                                    </a>
                                </li>
                                @* uncompled *@
                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        <img src="~/assets/icons/door-check-out-icon.svg" class="nav-hover" /><br />
                                        <span>Logout</span>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Account" asp-action="Register">
                                        <img src="~/assets/icons/register-icon.png" class="nav-hover" /><br />
                                        <span>Register</span>
                                    </a>
                                </li> 

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Account" asp-action="logIn">
                                        <img src="~/assets/icons/account-login.png" class="nav-hover" /><br />
                                        <span>Login</span>
                                    </a>
                                </li>
                            }

                        </ul>
                    </div>
                </div>
            </div>
        </nav>

    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - BlOO - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

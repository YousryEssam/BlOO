@model List<PostViewModel>
@{
    ViewData["Title"] = "Post";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<link rel="stylesheet" href="~/css/post-page.css" asp-append-version="true" />



<partial name="_AddPosts" />


<div id="postContainer" class="container">
    @if (Model.Count > 0)
    {
        @foreach (var post in Model)
        {
            <partial name="_PostComponent" model="post" />
        }
    }
    else
    {
        <div class="container my-5">
            <div class="row justify-content-center text-center">
                <div class="col-md-11">
                    <div class="no-posts-box text-center shadow-sm p-5">
                        <img src="~/assets/post-pictures/NoPostsYet.jpg" alt="No posts" class="mb-6 no-posts-img">
                        <h3 class="text-muted mb-2">No posts available at the moment</h3>
                    </div>
                </div>
            </div>
        </div>


    }

</div>







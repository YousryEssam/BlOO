@{
    ViewData["Title"] = "Admin";
}
<table class="table table-bordered table-hover text-center table-striped align-middle shadow mt-4">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Min Degree</th>
            <th>Department</th>
            <th>Instructor</th>
            <th>Course Results</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>1</td>
            <td>Mathematics</td>
            <td>50</td>
            <td>Science</td>
            <td>
                <select class="form-select form-select-sm">
                    <option>Dr. Ahmed</option>
                    <option>Dr. Sara</option>
                </select>
            </td>
            <td>
                85, 90, 78
            </td>
            <td>
                <a href="#" class="btn btn-sm btn-primary me-1">
                    <i class="bi bi-eye"></i> Show
                </a>
                <a href="#" class="btn btn-sm btn-warning me-1">
                    <i class="bi bi-pencil-square"></i> No Action
                </a>
                <form style="display:inline" method="post" onsubmit="return confirm('Are you sure you want to delete this course?');">
                    <button type="submit" class="btn btn-sm btn-danger">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </form>
            </td>
        </tr>
        <tr>
            <td>2</td>
            <td>Physics</td>
            <td>60</td>
            <td>Engineering</td>
            <td>
                <select class="form-select form-select-sm">
                    <option>Dr. Hany</option>
                    <option>Dr. Mona</option>
                </select>
            </td>
            <td>
                72, 88
            </td>
            <td>
                <a href="#" class="btn btn-sm btn-primary me-1">
                    <i class="bi bi-eye"></i> Show
                </a>
                <a href="#" class="btn btn-sm btn-warning me-1">
                    <i class="bi bi-pencil-square"></i> No Action
                </a>
                <form style="display:inline" method="post" onsubmit="return confirm('Are you sure you want to delete this course?');">
                    <button type="submit" class="btn btn-sm btn-danger">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </form>
            </td>
        </tr>
    </tbody>
</table>

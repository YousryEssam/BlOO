@model PostViewModel

@{
    ViewData["Title"] = "Edit Post";
}

<link rel="stylesheet" href="~/css/Add&EditPost.css" asp-append-version="true" />

@* <link rel="stylesheet" href="/css/EditPost.css" asp-append-version="true" /> *@

<h2 class="edit-post-title">Edit Post</h2>


    <form id="postForm" class="post-input-container" asp-controller="Post" asp-action="SaveEditedPost" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" value="@Model.Id" />
    <input type="hidden" asp-for="OwnerId" value="@Model.OwnerId" />
    <img src="@User.FindFirst("imgUrl")?.Value" alt="Profile Picture" class="profile-img">

    <textarea asp-for="Content" class="post-input" onfocus="openPost()"></textarea>
 
    <label  for="file-upload" class="upload-icon">
        <img src="~/assets/icons/upload-img.png" alt="Upload">
    </label>
    <input name="Image" id="file-upload" type="file" class="d-none" accept="image/*">

    <span asp-validation-for="Content" class="text-danger"></span>

    <div class="form-actions">
        <button type="submit" class="add-post-btn">Save Changes</button>
        <a href="javascript:history.back()" class="cancel-btn">Cancel edit</a>
    </div>

   
</form>

 <div class="post-input-container" style="text-align:center;">
    @if (!string.IsNullOrEmpty(Model.ImgUrl))
    {
        <div class="post-image-container" style="display: flex; justify-content: center; align-items: center; width: 100%; height: auto;">
            <img src="/assets/post-pictures/@Model.ImgUrl" class="post-image"  />
        </div>
    }

</div>


<div class="overlay" id="overlay" onclick="closePost()"></div>


<script>
    function openPost() {
        document.getElementById("overlay").style.display = "block";
        document.getElementById("postForm").classList.add("expanded");
    }

    function closePost() {
        document.getElementById("overlay").style.display = "none";
        document.getElementById("postForm").classList.remove("expanded");
    }

</script>


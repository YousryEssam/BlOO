@model EditProfileViewModel
@inject UserManager<ApplicationUser> UserManager;
@{
    ViewData["Title"] = "Edit Profile";
    var user = await UserManager.GetUserAsync(User);
}
<link href="~/css/edit-profile.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">

<div class="container">
    <div class="row edit-layout">
        <div class="title">
            <h3>Edit Your Profile</h3>
        </div>
        <div class="col-12">
            <form asp-controller="User" asp-action="SaveEdit" method="post" enctype="multipart/form-data">
                <div class="form-group d-none">
                    <label asp-for="ProfileId" class="control-label"></label>
                    <input asp-for="ProfileId" class="form-control" />
                    <span asp-validation-for="ProfileId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="FirstName" class="control-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LastName" class="control-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Bio" class="control-label"></label>
                    <textarea asp-for="Bio" class="form-control"></textarea>
                    <span asp-validation-for="Bio" class="text-danger"></span>
                </div>

                <!-- Profile Image Section -->
                <div class="form-group">
                    <label asp-for="ProfileImage" class="control-label"></label>
                    <input id="profileImageInput" type="file" class="form-control" accept="image/*" />
                    <input asp-for="ProfileImage" id="profileImageFile" type="file" class="d-none" />
                    <span asp-validation-for="ProfileImage" class="text-danger"></span>
                </div>
                <div id="profileImageCropContainer" class="crop-container d-none">
                    <p class="crop-instructions">Drag to position the image and use the corners to resize. Ensure your face is clearly visible in the center.</p>
                    <div class="image-container">
                        <img id="profileImageToCrop" src="#" />
                    </div>
                    <div class="crop-controls">
                        <button type="button" id="cropProfileImage" class="btn btn-primary">Crop and Set</button>
                        <button type="button" id="cancelProfileCrop" class="btn btn-secondary">Cancel</button>
                    </div>
                </div>
                <div id="profilePreviewContainer" class="preview-container d-none">
                    <p>Preview:</p>
                    <div class="preview-image-container profile-preview">
                        <img id="profileImagePreview" src="#" />
                    </div>
                </div>

                <!-- Cover Image Section -->
                <div class="form-group">
                    <label asp-for="CoverImage" class="control-label"></label>
                    <input id="coverImageInput" type="file" class="form-control" accept="image/*" />
                    <input asp-for="CoverImage" id="coverImageFile" type="file" class="d-none" />
                    <span asp-validation-for="CoverImage" class="text-danger"></span>
                </div>
                <div id="coverImageCropContainer" class="crop-container d-none">
                    <p class="crop-instructions">Position your image to best fit the wide cover area. The image will be cropped to fit a 3:1 ratio.</p>
                    <div class="image-container">
                        <img id="coverImageToCrop" src="#" />
                    </div>
                    <div class="crop-controls">
                        <button type="button" id="cropCoverImage" class="btn btn-primary">Crop and Set</button>
                        <button type="button" id="cancelCoverCrop" class="btn btn-secondary">Cancel</button>
                    </div>
                </div>
                <div id="coverPreviewContainer" class="preview-container d-none">
                    <p>Preview:</p>
                    <div class="preview-image-container cover-preview">
                        <img id="coverImagePreview" src="#" />
                    </div>
                </div>

                <div class="form-group btns">
                    <input type="submit" value="Save" class="btn btnsubmit" />
                    <a asp-controller="User" asp-action="Profile" asp-route-id="@user.Id" class="btn btn-outline-secondary back-btn">Back to Profile</a>
                </div>
            </form>
        </div>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

<script>
    // Define dimensions for profile and cover images
    const profileImageSettings = {
        aspectRatio: 1, // Square aspect ratio for profile picture
        width: 300,
        height: 300
    };

    const coverImageSettings = {
        aspectRatio: 3 / 1, // 3:1 aspect ratio for cover image
        width: 900,
        height: 300
    };

    // Variables to store cropper instances
    let profileCropper = null;
    let coverCropper = null;

    function createCropper(imageElement, settings, containerElement) {
        return new Cropper(imageElement, {
            aspectRatio: settings.aspectRatio,
            viewMode: 1, // Restrict the crop box to not exceed the size of the canvas
            guides: true,
            center: true,
            background: false, // Don't show the grid background
            autoCropArea: 0.8, // 80% of the image will be in the crop box initially
            responsive: true,
            checkOrientation: true, // Check if the image is rotated correctly
            minContainerWidth: 250,
            minContainerHeight: 250,
            // Prevent image from repeating
            checkCrossOrigin: true,
            // Make sure the entire crop area is covered by the image (no blank spaces)
            cropBoxMovable: true,
            cropBoxResizable: true,
            dragMode: 'move', // Allow moving the image within the crop box
            // When initializing, make sure the crop box covers as much of the image as possible
            ready: function() {
                // Get container dimensions
                const containerWidth = containerElement.clientWidth;
                const containerHeight = containerElement.clientHeight;

                // Adjust crop box to fill available space while maintaining aspect ratio
                const cropBoxData = this.cropper.getCropBoxData();
                const imageData = this.cropper.getImageData();

                // Ensure the crop box isn't larger than the container
                let newWidth = Math.min(containerWidth, cropBoxData.width);
                let newHeight = newWidth / settings.aspectRatio;

                if (newHeight > containerHeight) {
                    newHeight = containerHeight;
                    newWidth = newHeight * settings.aspectRatio;
                }

                // Center the crop box
                const left = (containerWidth - newWidth) / 2;
                const top = (containerHeight - newHeight) / 2;

                this.cropper.setCropBoxData({
                    left: left,
                    top: top,
                    width: newWidth,
                    height: newHeight
                });
            }
        });
    }

    // Profile Image Handling
    document.getElementById('profileImageInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;

        // Validate file type
        if (!file.type.match('image.*')) {
            alert('Please select an image file');
            return;
        }

        // Validate file size (5MB max)
        if (file.size > 5 * 1024 * 1024) {
            alert('Image size should not exceed 5MB');
            return;
        }

        const reader = new FileReader();
        reader.onload = function(event) {
            // Display the image and initialize cropper
            const img = document.getElementById('profileImageToCrop');
            img.src = event.target.result;

            document.getElementById('profileImageCropContainer').classList.remove('d-none');

            if (profileCropper) {
                profileCropper.destroy();
            }

            const container = document.querySelector('#profileImageCropContainer .image-container');
            profileCropper = createCropper(img, profileImageSettings, container);
        };
        reader.readAsDataURL(file);
    });

    document.getElementById('cropProfileImage').addEventListener('click', function() {
        if (!profileCropper) return;

        const canvas = profileCropper.getCroppedCanvas({
            width: profileImageSettings.width,
            height: profileImageSettings.height,
            imageSmoothingEnabled: true,
            imageSmoothingQuality: 'high'
        });

        canvas.toBlob(function(blob) {
            // Create a new File object
            const croppedFile = new File([blob], 'profile.jpg', { type: 'image/jpeg' });

            // Create a DataTransfer and add the file to it
            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(croppedFile);

            // Set the files property of the hidden file input
            document.getElementById('profileImageFile').files = dataTransfer.files;

            // Show preview
            const preview = document.getElementById('profileImagePreview');
            preview.src = URL.createObjectURL(blob);
            document.getElementById('profilePreviewContainer').classList.remove('d-none');

            // Hide the cropper
            document.getElementById('profileImageCropContainer').classList.add('d-none');

            // Destroy the cropper instance
            profileCropper.destroy();
            profileCropper = null;
        }, 'image/jpeg', 0.95); // 95% quality JPEG
    });

    document.getElementById('cancelProfileCrop').addEventListener('click', function() {
        document.getElementById('profileImageCropContainer').classList.add('d-none');
        document.getElementById('profileImageInput').value = '';
        if (profileCropper) {
            profileCropper.destroy();
            profileCropper = null;
        }
    });

    // Cover Image Handling
    document.getElementById('coverImageInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;

        // Validate file type
        if (!file.type.match('image.*')) {
            alert('Please select an image file');
            return;
        }

        // Validate file size (5MB max)
        if (file.size > 5 * 1024 * 1024) {
            alert('Image size should not exceed 5MB');
            return;
        }

        const reader = new FileReader();
        reader.onload = function(event) {
            // Display the image and initialize cropper
            const img = document.getElementById('coverImageToCrop');
            img.src = event.target.result;

            document.getElementById('coverImageCropContainer').classList.remove('d-none');

            if (coverCropper) {
                coverCropper.destroy();
            }

            const container = document.querySelector('#coverImageCropContainer .image-container');
            coverCropper = createCropper(img, coverImageSettings, container);
        };
        reader.readAsDataURL(file);
    });

    document.getElementById('cropCoverImage').addEventListener('click', function() {
        if (!coverCropper) return;

        const canvas = coverCropper.getCroppedCanvas({
            width: coverImageSettings.width,
            height: coverImageSettings.height,
            imageSmoothingEnabled: true,
            imageSmoothingQuality: 'high'
        });

        canvas.toBlob(function(blob) {
            // Create a new File object
            const croppedFile = new File([blob], 'cover.jpg', { type: 'image/jpeg' });

            // Create a DataTransfer and add the file to it
            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(croppedFile);

            // Set the files property of the hidden file input
            document.getElementById('coverImageFile').files = dataTransfer.files;

            // Show preview
            const preview = document.getElementById('coverImagePreview');
            preview.src = URL.createObjectURL(blob);
            document.getElementById('coverPreviewContainer').classList.remove('d-none');

            // Hide the cropper
            document.getElementById('coverImageCropContainer').classList.add('d-none');

            // Destroy the cropper instance
            coverCropper.destroy();
            coverCropper = null;
        }, 'image/jpeg', 0.95); // 95% quality JPEG
    });

    document.getElementById('cancelCoverCrop').addEventListener('click', function() {
        document.getElementById('coverImageCropContainer').classList.add('d-none');
        document.getElementById('coverImageInput').value = '';
        if (coverCropper) {
            coverCropper.destroy();
            coverCropper = null;
        }
    });
</script>
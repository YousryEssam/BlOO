@model ProfileViewModel 
@inject UserManager<ApplicationUser> UserManager 
@inject SignInManager<ApplicationUser> SignInManager
@{
    ViewData["Title"] = "Profile";
    string FullName = Model.FirstName + " " + Model.LastName;
    var loggedInUser = await UserManager.GetUserAsync(User); // Get current logged-in user
    bool isProfileOwner = loggedInUser != null && loggedInUser.Id == Model.UserId;
    bool isFollower = false;
    int curUser = loggedInUser.Id;
}

<link rel="stylesheet" href="~/css/post-page.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/profile-page.css" asp-append-version="true" />

@* ********************************** Profile info Section begin *************************************** *@
<div class="profile-card">    
    <div class="cover-photo" style="background : url('@Model.CoverImageUrl');">
        <img src="@Model.ProfileImageUrl" alt="Profile" class="profile-photo">
    </div>

    <!-- Profile Info -->
    <div class="profile-info">

        <h4 class="profile-name">@FullName</h4>  
        <p class="username">&#64;@Model.UserName</p>
        <p>
            <strong>Bio :</strong> <br/>
            @if(Model.Bio != null)
            {
                @Model.Bio
            }
        </p>

        <!-- Follow & Message Buttons -->
        <div class="profile-actions d-flex justify-content-end gap-3">
            @if (SignInManager.IsSignedIn(User))
            {
                // to Get data in Js file
                <div style="display :none;" id="user-data" data-profile-id="@Model.UserId" data-current-user="@curUser"></div>

                if (isProfileOwner)
                {
                    <a asp-controller="User" asp-action="EditProfile" class="btn btn-outline-secondary"><i class="fa-solid fa-pen"></i> Edit profile</a>
                }
                else
                {
                    // Follow buttons
                    <button id="follow-btn" class="btn btn-primary visually-hidden" onclick="FollowUser()"><i class="fas fa-user-plus"></i> Follow</button>
                    <button id="unfollow-btn" class="btn btn-danger visually-hidden" onclick="UnfollowUser()"><i class="fas fa-user-minus"></i> Unfollow</button>
         
                    <a asp-controller="Chats" asp-action="Chat" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">
                        <i class="fas fa-envelope"></i> Message
                    </a>
                }
            }
        </div>

    </div>

    <!-- Stats Section -->
    <div class="profile-stats">
        <div class="stat-profile-page">
           
            <a asp-controller="User" asp-action="Followers" asp-route-id="@Model.UserId" class="btn">
                <i class="fas fa-users"></i>
                <p>Followers</p>
                <strong id="FollowersCount"> @Model.FollowersCount </strong>
            </a>
        </div>
        <div class="stat-profile-page">
            <a asp-controller="User" asp-action="Following" asp-route-id="@Model.UserId" class="btn">
                <i class="fas fa-user-friends"></i>
                <p>Following</p>
                <strong id="FollowingCount">@Model.FollowingCount</strong>
            </a>
        </div>
        <div class="stat-profile-page">
            <i class="fas fa-file-alt"></i>
            <p>Posts</p>
            <strong>@Model.PostCount</strong>
        </div>
    </div>

</div>
@* ********************************** Profile info Section end *************************************** *@


@* **********************************Add post by partial view *************************************** *@

@{
    if (isProfileOwner)
    {
        <partial name="_AddPosts" />
    }
}

@* ***************************************** Posts by User ****************************************** *@

@{
    if(Model.PostCount == 0)
    {
        <div class="container my-5">
            <div class="row justify-content-center text-center">
                <div class="col-md-11">
                    <div class="no-posts-box text-center shadow-sm p-5">
                        <img src="~/assets/post-pictures/NoPostsYet.jpg" alt="No posts" class="mb-6 no-posts-img">
                        <h3 class="text-muted mb-2">No Posts Yet</h3>
                        <p class="text-secondary fs-5">This user hasn't shared any posts yet. Check back later!</p>
                    </div>
                </div>
            </div>
        </div>

    }
    else
    {
        <div class="container">
            <h1 class="text-center">Posts</h1>
            <div id="postContainer">
                @{
                    if (Model.Posts != null)
                    {
                        foreach (var post in Model.Posts)
                        {
                            <partial name="_PostComponent" model="post" />
                        }
                    }
                }
            </div>
        </div>
    }
}


@* Imports script *@
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/microsoft-signalr/signalr.min.js"></script>
<script src="~/js/followers-system.js"></script>

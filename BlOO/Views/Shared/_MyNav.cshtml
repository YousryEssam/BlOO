<!DOCTYPE html>
<html lang="en">
	<head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - BlOO</title>
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/Navbar.css" asp-append-version="true" />
	</head>

    <body>
        <header>
            <nav class="nav navbar-expand-lg bg-white sticky-top border-bottom">
               
                <div class="container-fluid">
                    <div class="row text-center">
                        
                        <div class="col-4 d-flex align-items-center">
                            <a class="navbar-brand d-flex align-items-center" href="#">
                                <img src="~/assets/logo/logo.jpg" class="rounded-circle logo-img" />
                            </a>
                            <img src="~/assets/icons/search-icon.svg" alt="search-icon" style="margin:15px;"/>
                            <input class="form-control custom-input" type="Search" placeholder="Search" name="search" id="search" />
                        </div>

                        <div class="col-6">
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        <img src="~/assets/icons/home-button-icon.svg" class="nav-hover" />
                                        <br />
                                        <span>Home</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        <img src="~/assets/icons/compass-icon.svg" class="nav-hover" />
                                        <br />
                                        <span>Explore</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        <img src="~/assets/icons/notification-icon.svg" class="nav-hover" />
                                        <br />
                                        <span>Notification</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        <img src="~/assets/icons/setting-icon.svg" class="nav-hover" />
                                        <br />
                                        <span>Setting</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        <img src="~/assets/icons/message-bubble-icon.svg" class="nav-hover" />
                                        <br />
                                        <span>Messages</span>
                                    </a>
                                </li>
                            </ul>
                        </div>


                        <div class="col-2">
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        <img src="~/assets/icons/user.png" class="rounded-circle nav-hover" /><br />
                                        <span>My Profile</span>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        <img src="~/assets/icons/door-check-out-icon.svg" class="nav-hover" /><br />
                                        <span>Logout</span>
                                    </a>
                                </li>

                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

        </header>

        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

    </body>
</html>
@model PostViewModel

@{
    ViewData["Title"] = "Edit Post";
}

<link rel="stylesheet" href="/css/EditPost.css" asp-append-version="true" />

<h2>Edit Post</h2>

<div class="edit-post-container">
    <form asp-controller="Post" asp-action="SaveEditedPost" method="post" enctype="multipart/form-data">
        <span asp-validation-for="Content" class="text-danger"></span>
        <input type="hidden" asp-for="Id" value="@Model.Id" />
        <input type="hidden" asp-for="OwnerId" value="@Model.OwnerId" />

        <div class="form-group">
            <label asp-for="Content">Post Content</label>
            <textarea asp-for="Content" class="form-control"></textarea>
        </div>
        <div class="form-group">
            <label asp-for="ImgUrl">New Image</label>
            <input asp-for="ImgUrl" class="form-control" />

            @* <label>New Image</label> *@
            @* <label for="file-upload" class="upload-icon"> *@
            @*     <img src="~/assets/icons/upload-img.png" alt="Upload"> *@
            @* </label> *@
            @* <input name="Image" id="file-upload" type="file" class="d-none" accept="image/*"> *@

        </div>

        <div class="form-actions">
            <button type="submit" class="btn btnSave ">Save Changes</button>
            <a href="javascript:history.back()" class="btn btn-secondary">
                Cancel edit
            </a>
        </div>

    </form>
</div>